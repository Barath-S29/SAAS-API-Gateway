# Copy this file to .env and adjust local values.
# .env itself is gitignored -- never commit real credentials.

# --- Postgres container (read by `docker compose`) ---
POSTGRES_USER=gateway
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=gateway
# Host port for Postgres. Change it if 5432 is taken or reserved on your machine,
# and change the port inside DATABASE_URL below to the same number.
POSTGRES_PORT=5432

# --- App settings (read by pydantic-settings in app/core/config.py) ---
# The user, password and database below MUST match the three values above.
# Keep the dev password URL-safe (letters, digits, dashes) so it needs no encoding.
DATABASE_URL=postgresql+psycopg://gateway:changeme-local-only@localhost:5432/gateway
